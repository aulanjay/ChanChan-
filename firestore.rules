rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products: Available for authenticated users to view menu; staff/owner to update stock & menu
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Orders: Customer food orders
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // User profiles & loyalty points
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || true);
    }

    // Outlets & stores
    match /outlets/{outletId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Vouchers & promos
    match /vouchers/{voucherId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
